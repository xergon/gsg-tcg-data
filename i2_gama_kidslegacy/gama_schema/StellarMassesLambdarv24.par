# StellarMasses
# StellarMassesLambdar
# v24
# 2021-06-04
# Edward Taylor <entaylor@swin.edu.au>
#
# This table provides stellar masses, restframe photometry, and other
# ancillary stellar population parameters from stellar population fits
# to multiband SEDs (using LAMBDAR photometry) for all D > 0 objects
# in the equatorial survey regions.
#
CATAID                 1  -                 meta.id;meta.main                unique GAMA II ID of GAMA object
Z                      2  -                 src.redshift                     heliocentric redshift
comovingdist           3  Mpc               pos.distance                     comoving distance, derived using Z_TONRY
nefffilt               4  -                 meta.number                      effective number of filters used in SPS fit
snratio                5  -                 meta.number                      net signal-to-noise across all filters used for SPS fit
ppp                    6  -                 meta.number                      Posterior Predictive P-value goodness-of-fit statistic
nefftemp               7  -                 meta.number                      effective number of filters contributing to SPS fit
logmstar               8  dex(Msun)         phys.mass                        stellar mass estimate
dellogmstar            9  dex(Msun)         stat.error                       statistical uncertainty in logmstar
mstar                 10  Msun              phys.mass                        stellar mass estimate
delmstar              11  Msun              stat.error                       statistical uncertainty in mstar
logage                12  dex(yr)           time.age                         time since start of star formation
dellogage             13  dex(yr)           stat.error                       statistical uncertainty in logage
logtau                14  dex(yr)           time.scale                       star formation history e-folding time
dellogtau             15  dex(yr)           stat.error                       statistical uncertainty in logtau
logmet                16  -                 phys.abund.Z                     stellar metallicity Z = log [O/H] (Z_sol = 0.02)
dellogmet             17  -                 stat.error                       statistical uncertainty in logmet
dustEBV               18  mag               phys.absorption                  single screen dust extinction E(B-V)
deldustEBV            19  mag               stat.error                       statistical uncertainty in dustEBV
logmremnants          20  dex(Msun)         phys.mass                        mass in subluminous stellar remnants
dellogmremnants       21  dex(Msun)         stat.error                       statistical uncertainty in logmremnants
logmintsfh            22  dex(Msun)         phys.mass                        mass inferred from integration over the full SFH
dellogmintsfh         23  dex(Msun)         stat.error                       statistical uncertainty in logmintsfh
logLWage              24  dex(yr)           time.age                         light-weighted mean stellar age
dellogLWage           25  dex(yr)           stat.error                       statistical uncertainty in logLWage
uminusr               26  mag               phot.color                       restframe (u-r) colour
deluminusr            27  mag               stat.error                       statistical uncertainty in uminusr
uminusr_stars         28  mag               phot.color                       intrinsic stellar (u-r) colour (corrected for internal dust)
deluminusr_stars      29  mag               stat.error                       statistical uncertainty in uminusr_stars
gminusi               30  mag               phot.color                       restframe (g-i) colour
delgminusi            31  mag               stat.error                       statistical uncertainty in gminusi
gminusi_stars         32  mag               phot.color                       intrinsic stellar (g-i) colour (corrected for internal dust)
delgminusi_stars      33  mag               stat.error                       statistical uncertainty in gminusi_stars
logmoverl_i           34  dex(Msun/Lsun,i)  phys.composition.massLightRatio  i-band mass-to-light ratio
dellogmoverl_i        35  dex(Msun/Lsun,i)  stat.error                       statistical uncertainty in logmoverl_i
C_logM_gi             36  -                 stat.correlation                 correlation coefficient for logmstar and gminusi
C_logM_gistars        37  -                 stat.correlation                 correlation coefficient for logmstar and gminusi_stars
C_logM_ur             38  -                 stat.correlation                 correlation coefficient for logmstar and uminusr
C_logM_urstars        39  -                 stat.correlation                 correlation coefficient for logmstar and uminusr_stars
C_logM_logLWage       40  -                 stat.correlation                 correlation coefficient for logmstar and logLWage
C_logM_EBV            41  -                 stat.correlation                 correlation coefficient for logmstar and dustEBV
absmag_FUV            42  mag               phys.magAbs                      FUV-band absolute magnitude (restframe; AB)
delabsmag_FUV         43  mag               stat.error                       statistical uncertainty in absmag_FUV
absmag_NUV            44  mag               phys.magAbs                      NUV-band absolute magnitude (restframe; AB)
delabsmag_NUV         45  mag               stat.error                       statistical uncertainty in absmag_NUV
absmag_u              46  mag               phys.magAbs                      u-band absolute magnitude (restframe; AB)
delabsmag_u           47  mag               stat.error                       statistical uncertainty in absmag_u
absmag_g              48  mag               phys.magAbs                      g-band absolute magnitude (restframe; AB)
delabsmag_g           49  mag               stat.error                       statistical uncertainty in absmag_g
absmag_r              50  mag               phys.magAbs                      r-band absolute magnitude (restframe; AB)
delabsmag_r           51  mag               stat.error                       statistical uncertainty in absmag_r
absmag_i              52  mag               phys.magAbs                      i-band absolute magnitude (restframe; AB)
delabsmag_i           53  mag               stat.error                       statistical uncertainty in absmag_i
absmag_Z              54  mag               phys.magAbs                      Z-band absolute magnitude (restframe; AB)
delabsmag_Z           55  mag               stat.error                       statistical uncertainty in absmag_Z
absmag_Y              56  mag               phys.magAbs                      Y-band absolute magnitude (restframe; AB)
delabsmag_Y           57  mag               stat.error                       statistical uncertainty in absmag_Y
absmag_J              58  mag               phys.magAbs                      J-band absolute magnitude (restframe; AB)
