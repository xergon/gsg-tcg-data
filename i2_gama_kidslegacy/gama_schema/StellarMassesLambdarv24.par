absmag_W2             66  mag               phys.magAbs                      W2-band absolute magnitude (restframe; AB)
delabsmag_W2          67  mag               stat.error                       statistical uncertainty in absmag_W2
absmag_FUV_stars      68  mag               phys.magAbs                      intrinsic stellar FUV-band absolute magnitude (restframe; AB)
delabsmag_FUV_stars   69  mag               stat.error                       statistical uncertainty in absmag_FUV_stars
absmag_NUV_stars      70  mag               phys.magAbs                      intrinsic stellar NUV-band absolute magnitude (restframe; AB)
delabsmag_NUV_stars   71  mag               stat.error                       statistical uncertainty in absmag_NUV_stars
absmag_u_stars        72  mag               phys.magAbs                      intrinsic stellar u-band absolute magnitude (restframe; AB)
delabsmag_u_stars     73  mag               stat.error                       statistical uncertainty in absmag_u_stars
absmag_g_stars        74  mag               phys.magAbs                      intrinsic stellar g-band absolute magnitude (restframe; AB)
delabsmag_g_stars     75  mag               stat.error                       statistical uncertainty in absmag_g_stars
absmag_r_stars        76  mag               phys.magAbs                      intrinsic stellar r-band absolute magnitude (restframe; AB)
delabsmag_r_stars     77  mag               stat.error                       statistical uncertainty in absmag_r_stars
absmag_i_stars        78  mag               phys.magAbs                      intrinsic stellar i-band absolute magnitude (restframe; AB)
delabsmag_i_stars     79  mag               stat.error                       statistical uncertainty in absmag_i_stars
absmag_Z_stars        80  mag               phys.magAbs                      intrinsic stellar Z-band absolute magnitude (restframe; AB)
delabsmag_Z_stars     81  mag               stat.error                       statistical uncertainty in absmag_Z_stars
absmag_Y_stars        82  mag               phys.magAbs                      intrinsic stellar Y-band absolute magnitude (restframe; AB)
delabsmag_Y_stars     83  mag               stat.error                       statistical uncertainty in absmag_Y_stars
absmag_J_stars        84  mag               phys.magAbs                      intrinsic stellar J-band absolute magnitude (restframe; AB)
delabsmag_J_stars     85  mag               stat.error                       statistical uncertainty in absmag_J_stars
absmag_H_stars        86  mag               phys.magAbs                      intrinsic stellar H-band absolute magnitude (restframe; AB)
delabsmag_H_stars     87  mag               stat.error                       statistical uncertainty in absmag_H_stars
absmag_K_stars        88  mag               phys.magAbs                      intrinsic stellar K-band absolute magnitude (restframe; AB)
delabsmag_K_stars     89  mag               stat.error                       statistical uncertainty in absmag_K_stars
absmag_W1_stars       90  mag               phys.magAbs                      intrinsic stellar W1-band absolute magnitude (restframe; AB)
delabsmag_W1_stars    91  mag               stat.error                       statistical uncertainty in absmag_W1_stars
absmag_W2_stars       92  mag               phys.magAbs                      intrinsic stellar W2-band absolute magnitude (restframe; AB)
delabsmag_W2_stars    93  mag               stat.error                       statistical uncertainty in absmag_W2_stars
fitflux_FUV           94  Jy                phot.flux.density                observers frame FUV-band flux from SPS fit
delfitflux_FUV        95  Jy                stat.error                       statistical uncertainty in fitflux_FUV
fitflux_NUV           96  Jy                phot.flux.density                observers frame NUV-band flux from SPS fit
